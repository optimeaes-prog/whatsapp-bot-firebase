{
  "name": "whatsapp-bot-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for WhatsApp Bot",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clone:twilio-content": "npm run build && node lib/scripts/cloneTwilioContentTemplates.js",
    "migrate:assistant-avatar-name": "npm run build && node lib/scripts/migrateAssistantAvatarNameToBotConfigConfig.js --project-id=real-estate-idealista-bot --database-id=realestate-whatsapp-bot",
    "send:test-welcome-email": "npm run build && node lib/scripts/sendTestWelcomeEmail.js",
    "test": "npm run build && node --test lib/tests/**/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.1.0",
    "@sendgrid/mail": "^8.1.1",
    "axios": "^1.16.1",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "jszip": "^3.10.1",
    "nodemailer": "^7.0.13",
    "openai": "^4.28.0",
    "stripe": "^20.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.9",
    "typescript": "^5.3.0"
  },
  "private": true
}
