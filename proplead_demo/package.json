{
  "name": "proplead_demo",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.465",
    "@remotion/google-fonts": "^4.0.465",
    "@remotion/tailwind-v4": "4.0.465",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.465",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.465",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:conversaciones": "remotion render conversaciones out/conversaciones.mp4 --concurrency=2 --timeout=120000",
    "render:leads-cualificados": "remotion render leads-cualificados out/leads-cualificados.mp4 --concurrency=2 --timeout=120000",
    "render:leads-bulk": "remotion render leads-bulk out/leads-bulk.mp4 --concurrency=2 --timeout=120000",
    "render:dashboard": "remotion render dashboard out/dashboard.mp4 --concurrency=2 --timeout=120000",
    "render:crear-anuncio": "remotion render crear-anuncio out/crear-anuncio.mp4 --concurrency=2 --timeout=120000",
    "render:all": "npm run render:conversaciones && npm run render:leads-cualificados && npm run render:leads-bulk && npm run render:dashboard && npm run render:crear-anuncio"
  },
  "sideEffects": [
    "*.css"
  ]
}
