{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/voice/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://app.cal.com https://app.cal.eu https://js.stripe.com https://*.firebaseapp.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://app.cal.com https://app.cal.eu; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.stripe.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.facebook.com https://*.facebook.com wss://*.firebaseio.com https://*.cal.com https://*.cal.eu; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://app.cal.com https://app.cal.eu https://*.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=(), payment=(self)"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/meta-data-deletion",
        "function": {
          "functionId": "metaDataDeletion",
          "region": "europe-west1"
        }
      },
      {
        "source": "/w/**",
        "function": {
          "functionId": "waRedirect",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/email-preferences",
        "function": {
          "functionId": "emailPreferencesApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/email-preferences/**",
        "function": {
          "functionId": "emailPreferencesApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/email-unsubscribe",
        "function": {
          "functionId": "emailUnsubscribe",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/email-unsubscribe/**",
        "function": {
          "functionId": "emailUnsubscribe",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/auth/password-reset",
        "function": {
          "functionId": "passwordResetRequest",
          "region": "europe-west1"
        }
      },
      {
        "source": "/landingv2/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "realestate-whatsapp-bot",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
