{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/voice/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/meta-data-deletion",
        "function": {
          "functionId": "metaDataDeletion",
          "region": "europe-west1"
        }
      },
      {
        "source": "/w/**",
        "function": {
          "functionId": "waRedirect",
          "region": "europe-west1"
        }
      },
      {
        "source": "/landingv2/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "realestate-whatsapp-bot",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
