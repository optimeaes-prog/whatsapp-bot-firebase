rules_version = '2';

// Firebase Storage rules for the default bucket.
// Outbound/inbound audio buckets are accessed only by Cloud Functions via
// the Admin SDK, which bypasses these rules — so we deny direct client access
// to those paths here.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/realestate-whatsapp-bot/documents/users/$(request.auth.uid)).data;
    }

    function getOrgId() {
      return getUserData().orgId;
    }

    function getRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == "super_admin";
    }

    function isOrgManager(orgId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (getOrgId() == orgId && (getRole() == "admin" || getRole() == "owner"))
      );
    }

    // Consent proofs uploaded from the dashboard. Org members can read; only
    // managers (owner/admin) of the same org or super_admin can write.
    // Size capped at 10 MiB and content type restricted to images / PDFs.
    match /organizations/{orgId}/consent-proofs/{leadId}/{fileName} {
      allow read: if isAuthenticated() && (getOrgId() == orgId || isSuperAdmin());
      allow write: if isOrgManager(orgId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        (
          request.resource.contentType.matches("image/.*") ||
          request.resource.contentType == "application/pdf"
        );
    }

    // Assistant profile photo (e.g. agency logo) used on the WhatsApp Business
    // profile. Public-read so Meta/Twilio can fetch the URL when applying it to
    // the sender profile; only org managers can write. JPG/PNG, max 5 MiB.
    match /organizations/{orgId}/assistant-photo/{fileName} {
      allow read: if true;
      allow write: if isOrgManager(orgId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        (
          request.resource.contentType == "image/jpeg" ||
          request.resource.contentType == "image/png"
        );
    }

    // Captación photos uploaded from the dashboard. Any org member (agents create
    // captaciones too, not only managers) can read/write/delete their org's photos.
    // Images only, max 10 MiB.
    match /organizations/{orgId}/captacion-photos/{captacionId}/{fileName} {
      allow read: if isAuthenticated() && (getOrgId() == orgId || isSuperAdmin());
      allow write: if isAuthenticated() && (getOrgId() == orgId || isSuperAdmin()) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
      allow delete: if isAuthenticated() && (getOrgId() == orgId || isSuperAdmin());
    }

    // Default deny for any other path. Audio assets and any other server-managed
    // content are written via the Admin SDK and don't need a client-facing rule.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
