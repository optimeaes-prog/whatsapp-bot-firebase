rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can read/write
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /organizations/{orgId} {
      allow read, write: if request.auth != null;

      // Listings (formerly anuncios) - authenticated users can CRUD
      match /listings/{listingId} {
        allow read, write: if request.auth != null;
      }
      
      // Leads - authenticated users can read, functions can write
      match /leads/{leadId} {
        allow read, write: if request.auth != null;
      }
      
      // Conversations (formerly conversaciones) - authenticated users can read, functions can write
      match /conversations/{convId} {
        allow read, write: if request.auth != null;
      }
      
      // Bot Config - authenticated users can read/write
      match /botConfig/{configId} {
        allow read, write: if request.auth != null;
      }
      
      // Credits - users can read their own balance, only backend functions can write
      match /credits/{userId} {
        allow read: if request.auth != null; // Since org id encapsulates, kept simple for now
        allow write: if false;  
      }
      
      // Credit Transactions - users can read their own transactions
      match /creditTransactions/{transactionId} {
        allow read: if request.auth != null;
        allow write: if false;  
      }
    }
  }
}
