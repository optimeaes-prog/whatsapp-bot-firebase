rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public status page for Meta Data Deletion Requests. Readable by anyone who
    // knows the opaque confirmation code (the doc ID); writes are server-only.
    match /dataDeletionRequests/{code} {
      allow read: if true;
      allow write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getOrgId() {
      return getUserData().orgId;
    }
    
    function getRole() {
       return getUserData().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == "super_admin";
    }

    function canAccessOrg(orgId) {
      return isAuthenticated() && (getOrgId() == orgId || isSuperAdmin());
    }

    function canManageOrg(orgId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (getOrgId() == orgId && (getRole() == "admin" || getRole() == "owner"))
      );
    }

    function isValidSelfUserCreate() {
      return request.resource.data.orgId is string &&
        request.resource.data.role == "member";
    }

    function isSafeSelfUserUpdate() {
      return request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.role == resource.data.role;
    }

    // Platform operator: self-upgrade to super_admin without changing org (verify email in ID token).
    function isInternalSuperAdminEmailForUser(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        request.auth.token.email == "ejperezreyes@gmail.com";
    }

    function isAllowlistedSuperAdminRoleUpgrade(userId) {
      return isInternalSuperAdminEmailForUser(userId) &&
        request.resource.data.role == "super_admin" &&
        (!("orgId" in resource.data) || request.resource.data.orgId == resource.data.orgId);
    }

    // Users can read their own profile. Writes are constrained to prevent role/org escalation.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidSelfUserCreate();
      allow update: if isAuthenticated() && request.auth.uid == userId && (
        isSafeSelfUserUpdate() || isAllowlistedSuperAdminRoleUpgrade(userId)
      );
      allow delete: if false;
      // Also allow owners/admins of the same org to read
      allow read: if isAuthenticated() && (getOrgId() == resource.data.orgId || isSuperAdmin());
    }
    
    match /organizations/{orgId} {
      // Organization access is restricted to members
      allow read: if canAccessOrg(orgId);
      allow write: if canManageOrg(orgId);

      match /botConfig/{configId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }

      match /listings/{listingId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }
      
      match /leads/{leadId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }
      
      match /conversations/{convId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }

      match /calls/{callId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }

      match /ignoredChats/{chatId} {
        allow read: if canAccessOrg(orgId);
        allow write: if canManageOrg(orgId);
      }
    }

    match /system_alerts/{alertId} {
      allow read: if isAuthenticated() && (getOrgId() == resource.data.orgId || getRole() == 'admin' || getRole() == 'owner');
      allow write: if isAuthenticated(); 
    }

    match /qualifiedLeads/{leadId} {
      allow read: if isAuthenticated() && (getOrgId() == resource.data.orgId || getRole() == 'admin' || getRole() == 'owner');
      allow write: if isAuthenticated() && (getRole() == 'admin' || getRole() == 'owner');
    }

    match /auditLogs/{logId} {
       allow read: if isAuthenticated() && getOrgId() == resource.data.orgId;
    }

    // COLLECTION GROUP RULES
    match /{path=**}/leads/{lead} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/conversations/{conversation} {
      allow read: if isAuthenticated();
    }
  }
}
