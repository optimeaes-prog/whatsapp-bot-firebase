rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getOrgId() {
      return getUserData().orgId;
    }
    
    function getRole() {
       return getUserData().role;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      // Also allow owners/admins of the same org to read
      allow read: if isAuthenticated() && getOrgId() == resource.data.orgId;
    }
    
    match /organizations/{orgId} {
      // Organization access is restricted to members
      allow read: if isAuthenticated() && getOrgId() == orgId;
      allow write: if isAuthenticated() && getOrgId() == orgId && (getRole() == 'admin' || getRole() == 'owner');

      match /botConfig/{configId} {
        allow read, write: if isAuthenticated() && getOrgId() == orgId;
      }

      match /listings/{listingId} {
        allow read: if isAuthenticated() && getOrgId() == orgId;
        allow write: if isAuthenticated() && getOrgId() == orgId && (getRole() == 'admin' || getRole() == 'owner');
      }
      
      match /leads/{leadId} {
        allow read: if isAuthenticated() && getOrgId() == orgId;
        allow write: if isAuthenticated() && getOrgId() == orgId && (getRole() == 'admin' || getRole() == 'owner');
      }
      
      match /conversations/{convId} {
        allow read: if isAuthenticated() && getOrgId() == orgId;
        allow write: if isAuthenticated() && getOrgId() == orgId && (getRole() == 'admin' || getRole() == 'owner');
      }

      match /calls/{callId} {
        allow read, write: if isAuthenticated() && getOrgId() == orgId;
      }

      match /ignoredChats/{chatId} {
        allow read, write: if isAuthenticated() && getOrgId() == orgId;
      }
    }

    match /system_alerts/{alertId} {
      allow read: if isAuthenticated() && (getOrgId() == resource.data.orgId || getRole() == 'admin' || getRole() == 'owner');
      allow write: if isAuthenticated(); 
    }

    match /qualifiedLeads/{leadId} {
      allow read: if isAuthenticated() && (getOrgId() == resource.data.orgId || getRole() == 'admin' || getRole() == 'owner');
      allow write: if isAuthenticated() && (getRole() == 'admin' || getRole() == 'owner');
    }

    match /auditLogs/{logId} {
       allow read: if isAuthenticated() && getOrgId() == resource.data.orgId;
    }

    // COLLECTION GROUP RULES
    match /{path=**}/leads/{lead} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/conversations/{conversation} {
      allow read: if isAuthenticated();
    }
  }
}
